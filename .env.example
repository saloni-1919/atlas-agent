# These are shell environment variables; the app does not auto-load .env.
# No external service needed for the default local/offline mode.
ATLAS_AI_PROVIDER=offline
ATLAS_RETRIEVAL=lexical
# Enable Ollama by setting ATLAS_AI_PROVIDER=ollama, ATLAS_RETRIEVAL=ollama
ATLAS_OLLAMA_MODEL=llama3.2:3b
ATLAS_EMBED_MODEL=nomic-embed-text
ATLAS_OLLAMA_URL=http://127.0.0.1:11434
# Optional OpenAI provider (only if selected). Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
